APP_ENV=development
DATABASE_URL=sqlite:///./var/ambatufit.db
JWT_SECRET=replace-with-the-same-long-random-secret-on-core-and-integration
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
AI_INFERENCE_URL=
AI_INFERENCE_TOKEN=
AI_TIMEOUT_SECONDS=4
INTEGRATION_API_BASE_URL=http://127.0.0.1:8200/integration/v1
INTEGRATION_API_TOKEN=replace-with-a-server-only-token
INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_MODE=mock
PARTNER_CONTRACTS_CONFIRMED=false
NUTRITION_PROVIDER_BASE_URL=
GYM_PROVIDER_BASE_URL=
NUTRITION_PROVIDER_API_KEY=
GYM_PROVIDER_API_KEY=
PARTNER_API_KEYS=
TUNNEL_TOKEN=

# Off-STB Conversational LLM & Embedding Settings (never commit real secrets)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_TOKENS=768
LLM_REPETITION_PENALTY=1.08
LLM_STOP_SEQUENCES=
EMBEDDING_PROVIDER=local_lsa
EMBEDDING_MODEL=local-multilingual-charword-lsa-v1
