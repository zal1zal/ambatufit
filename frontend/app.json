{
  "expo": {
    "name": "AmbatuFit",
    "slug": "ambatufit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "id.ambatufit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#182023"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "imageWidth": 390,
          "backgroundColor": "#F4F5F1",
          "resizeMode": "contain",
          "image": "./assets/splash.png"
        }
      ]
    ],
    "icon": "./assets/app-icon.png"
  }
}
